<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Use these instead of Margin.entitlements when building with your own Apple developer
	     team, to turn on "Sync with iCloud". See docs/icloud.md. -->
	<!-- Not sandboxed: Margin is a direct download, so it can run Claude Code and Codex for
	     the assistant. Its own defences: email HTML cleaned and shown without scripts, links
	     limited to the web and mail, attachments marked as downloaded and apps and scripts
	     never opened from mail (Tests/*/SafetyTests). Data from the sandboxed versions is
	     moved over once (SandboxMigration). The keys below are the Hardened Runtime's. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Files you choose: attaching them, and Save As for attachments. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Only for the MCP connection, which listens on 127.0.0.1 when turned on. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Only when you turn on contacts from the Contacts app, for address suggestions. -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<!-- Only when you choose Add to Reminders on a message. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Only while you dictate a question to Ask. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- iCloud: Sync with iCloud (mailboxes, settings, templates, workspaces). See docs/icloud.md. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(MARGIN_BUNDLE_ID)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.$(MARGIN_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
