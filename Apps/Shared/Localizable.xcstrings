    "Either way, Home sorts your mail into groups." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So oder so sortiert Start deine Mails in Gruppen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De cualquier forma, Inicio ordena tu correo en grupos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les deux cas, l’accueil trie votre courrier en groupes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les deux cas, l’accueil trie vos courriels en groupes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों ही तरह, होम आपके मेल को समूहों में छाँटता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Kezdőlap így is, úgy is csoportokba rendezi a leveleidet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ogni caso, la Home ordina la posta in gruppi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらでも、ホームがメールをグループに振り分けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 쪽이든 홈이 메일을 그룹으로 정리합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe dan ook sorteert Home je mail in groepen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De qualquer forma, o Início organiza seus e-mails em grupos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В любом случае «Главная» сортирует почту по группам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论哪种方式,主页都会把邮件整理到各个分组。"
          }
        },
        "tr" : {
          "stringUnit" : {
