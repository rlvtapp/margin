    "Backups are encrypted and include mail passwords, so a restore needs no signing in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups sind verschlüsselt und enthalten die Mail-Passwörter, sodass du dich nach einer Wiederherstellung nicht erneut anmelden musst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad están cifradas e incluyen las contraseñas del correo, así que al restaurar no hace falta volver a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes sont chiffrées et incluent les mots de passe de messagerie, si bien qu’aucune connexion n’est nécessaire après une restauration."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes sont chiffrées et incluent les mots de passe de courriel, si bien qu’aucune connexion n’est nécessaire après une restauration."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकअप एन्क्रिप्टेड होते हैं और उनमें मेल पासवर्ड शामिल होते हैं, इसलिए रीस्टोर करने के लिए साइन इन करने की ज़रूरत नहीं पड़ती।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mentések titkosítottak, és tartalmazzák a levelezési jelszavakat, így a visszaállításhoz nem kell újra bejelentkezned."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup sono cifrati e includono le password della posta, quindi dopo un ripristino non serve accedere di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップは暗号化され、メールのパスワードも含まれるため、復元後にサインインし直す必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업은 암호화되고 메일 암호도 포함돼요. 그래서 복원할 때 다시 로그인하지 않아도 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservekopieën zijn versleuteld en bevatten e-mailwachtwoorden, dus na het terugzetten hoef je niet opnieuw in te loggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups são criptografados e incluem as senhas de e-mail, então a restauração não exige novo login."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервные копии шифруются и включают пароли к почте, поэтому для восстановления входить заново не нужно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份已加密，并包含邮件密码，因此恢复时无需重新登录。"
          }
        }
      }
    },
