    "Connects over JMAP with an API token (Settings → Privacy & Security → API tokens)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindet sich über JMAP mit einem API-Token (Einstellungen → Datenschutz & Sicherheit → API-Tokens)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conecta mediante JMAP con un token de API (Ajustes → Privacidad y seguridad → Tokens de API)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion via JMAP avec un jeton d’API (Paramètres → Confidentialité et sécurité → Jetons d’API)."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
