    "Ideas, wishes, what you like. It goes to the Margin team." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideen, Wünsche, was dir gefällt. Es geht an das Margin-Team."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideas, deseos, lo que te gusta. Le llega al equipo de Margin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idées, souhaits, ce que vous aimez. C’est envoyé à l’équipe Margin."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idées, souhaits, ce que vous aimez. C’est envoyé à l’équipe Margin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विचार, इच्छाएँ, जो आपको पसंद है। यह Margin टीम को जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ötletek, kívánságok, ami tetszik. A Margin csapatához megy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idee, desideri, cosa ti piace. Arriva al team di Margin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
