          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin आपके ईमेल के आमंत्रणों की मीटिंग दिखाता है। पूरा कैलेंडर देखने के लिए कोई मेलबॉक्स कनेक्ट करें।"
