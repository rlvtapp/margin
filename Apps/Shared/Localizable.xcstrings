    "Both fill in the default signature, to change as you like." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide füllen die Standardsignatur aus, die du danach beliebig ändern kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambas rellenan la firma predeterminada, que luego puedes cambiar a tu gusto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux remplissent la signature par défaut, à modifier comme vous voulez."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux remplissent la signature par défaut, à modifier comme vous voulez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों डिफ़ॉल्ट हस्ताक्षर भर देते हैं, जिसे आप जैसे चाहें बदल सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindkettő az alapértelmezett aláírást tölti ki, amit utána tetszés szerint módosíthatsz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambi compilano la firma predefinita, da modificare come preferisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらも既定の署名に入力します。あとから自由に変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘 다 기본 서명을 채워 넣으며, 원하는 대로 바꿀 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide vullen de standaardhandtekening in, die je daarna naar wens aanpast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oba wypełniają podpis domyślny, który możesz potem dowolnie zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos preenchem a assinatura padrão, que você pode mudar como quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оба варианта заполняют подпись по умолчанию, которую затем можно изменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Båda fyller i standardsignaturen, som du sedan kan ändra som du vill."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkisi de varsayılan imzayı doldurur; sonra istediğin gibi değiştirebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
