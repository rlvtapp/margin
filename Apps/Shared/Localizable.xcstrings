          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, ChatGPT en andere apps die MCP ondersteunen, kunnen via Margin je e-mail doorzoeken en lezen, alleen op deze Mac."
          }
