    "Summarize this conversation in a few lines, and say what I'm asked to do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasse diese Unterhaltung in ein paar Zeilen zusammen und sag mir, was von mir erwartet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume esta conversación en unas líneas y dime qué se me pide que haga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résumer cette conversation en quelques lignes, et indiquer ce qu’on me demande de faire."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résumer cette conversation en quelques lignes, et indiquer ce qu’on me demande de faire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस वार्तालाप का कुछ पंक्तियों में सारांश बनाएँ, और बताएँ कि मुझसे क्या करने को कहा गया है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foglald össze ezt a beszélgetést néhány sorban, és mondd meg, mit kérnek tőlem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riassumi questa conversazione in poche righe e dimmi cosa mi viene chiesto di fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この会話を数行で要約し、私に求められていることを教えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화를 몇 줄로 요약하고, 내가 해야 할 일도 알려줘."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vat dit gesprek in een paar regels samen en zeg wat er van me wordt gevraagd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resuma esta conversa em poucas linhas e diga o que estão me pedindo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кратко изложи эту беседу в нескольких строках и скажи, что от меня требуется."
