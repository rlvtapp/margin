    "Your mailboxes and settings on all your devices. Passwords stay encrypted end to end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Postfächer und Einstellungen auf allen Geräten. Passwörter bleiben Ende-zu-Ende verschlüsselt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus buzones y ajustes en todos tus dispositivos. Las contraseñas siguen cifradas de extremo a extremo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos boîtes mail et réglages sur tous vos appareils. Les mots de passe restent chiffrés de bout en bout."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos boîtes de courriel et réglages sur tous vos appareils. Les mots de passe restent chiffrés de bout en bout."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सभी डिवाइस पर आपके मेलबॉक्स और सेटिंग्स। पासवर्ड एंड-टू-एंड एन्क्रिप्टेड रहते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A postafiókjaid és beállításaid minden eszközödön. A jelszavak végpontok között titkosítva maradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue caselle e impostazioni su tutti i dispositivi. Le password restano crittografate end-to-end."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールボックスと設定をすべてのデバイスで。パスワードはエンドツーエンドで暗号化されたままです。"
