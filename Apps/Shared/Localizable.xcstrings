    "Rules apply to new mail in the inbox while Margin is open, before you're alerted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeln gelten für neue Mail im Posteingang, solange Margin geöffnet ist, bevor du benachrichtigt wirst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas se aplican al correo nuevo de la bandeja mientras Margin está abierto, antes de avisarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles s'appliquent aux nouveaux e-mails de la boîte de réception tant que Margin est ouvert, avant toute alerte."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles s'appliquent aux nouveaux courriels de la boîte de réception tant que Margin est ouvert, avant toute alerte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin खुला रहने पर नियम इनबॉक्स की नई मेल पर सूचना से पहले लागू होते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szabályok az új beérkező levelekre vonatkoznak, amíg a Margin nyitva van, még az értesítés előtt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regole valgono per la nuova posta in arrivo mentre Margin è aperto, prima dell'avviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルールは、Margin を開いている間に受信箱に届く新着メールへ、通知の前に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "규칙은 Margin이 열려 있는 동안 받은 편지함의 새 메일에 알림 전에 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regels gelden voor nieuwe mail in de inbox zolang Margin open is, voordat je een melding krijgt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras valem para e-mails novos na caixa de entrada enquanto o Margin está aberto, antes do alerta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила применяются к новым письмам во Входящих, пока Margin открыт, до уведомления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin 打开时，规则会在提醒前作用于收件箱中的新邮件。"
          }
        }
      }
    },
