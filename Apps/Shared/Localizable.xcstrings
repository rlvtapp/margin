    "Or right-click a conversation and choose Create Rule… to start from its sender, domain or subject." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder klicke mit der rechten Maustaste auf eine Konversation und wähle „Regel erstellen …“, um von ihrem Absender, ihrer Domain oder ihrem Betreff auszugehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O haz clic derecho en una conversación y elige Crear regla… para partir de su remitente, dominio o asunto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou faites un clic droit sur une conversation et choisissez Créer une règle… pour partir de son expéditeur, de son domaine ou de son objet."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou faites un clic droit sur une conversation et choisissez Créer une règle… pour partir de son expéditeur, de son domaine ou de son objet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या किसी बातचीत पर राइट-क्लिक करके नियम बनाएँ… चुनें, ताकि उसके प्रेषक, डोमेन या विषय से शुरुआत हो।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vagy kattints jobb gombbal egy beszélgetésre, és válaszd a Szabály létrehozása… lehetőséget a feladója, domainje vagy tárgya alapján."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure fai clic destro su una conversazione e scegli Crea regola… per partire dal mittente, dal dominio o dall’oggetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または会話を右クリックして「ルールを作成…」を選ぶと、その差出人、ドメイン、件名から始められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 대화를 오른쪽 클릭하고 규칙 만들기…를 선택해 발신자, 도메인 또는 제목으로 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of klik met de rechtermuisknop op een gesprek en kies Regel maken… om te beginnen bij de afzender, het domein of het onderwerp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou clique com o botão direito em uma conversa e escolha Criar regra… para começar pelo remetente, domínio ou assunto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или щёлкните переписку правой кнопкой и выберите «Создать правило…», чтобы начать с её отправителя, домена или темы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以右键点按会话并选择“创建规则…”,从其发件人、域名或主题开始。"
          }
        }
      }
    },
