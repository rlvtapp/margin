          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask antwoordt uit je mail op dit apparaat: wat een antwoord nodig heeft, wat er deze week is, welke rekeningen openstaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Ask responde com base nos e-mails deste dispositivo: o que precisa de resposta, o que há nesta semana, que contas estão em aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask отвечает по почте на этом устройстве: что ждёт ответа, что на этой неделе, какие счета не оплачены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask 根据此设备上的邮件回答:哪些需要回复、本周有什么安排、哪些账单未付。"
          }
        }
      }
    },
    "Ask anything about your mail, or start with a command." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag alles zu deinen E-Mails oder starte mit einem Befehl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta lo que quieras sobre tu correo o empieza con un comando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez n’importe quelle question sur vos e-mails, ou commencez par une commande."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez n’importe quelle question sur vos courriels, ou commencez par une commande."
          }
        },
        "hi" : {
