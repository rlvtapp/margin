    "When a rule moves new mail, Margin says so and you can undo it for a few seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Regel neue Mails verschiebt, sagt Margin Bescheid, und du kannst es ein paar Sekunden lang rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando una regla mueve correo nuevo, Margin te avisa y puedes deshacerlo durante unos segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une règle déplace du nouveau courrier, Margin vous le signale et vous pouvez annuler pendant quelques secondes."
          }
