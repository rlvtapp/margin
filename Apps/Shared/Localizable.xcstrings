    "Claude, ChatGPT and other apps that support MCP can search and read your mail through Margin, on this Mac only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, ChatGPT und andere Apps mit MCP-Unterstützung können deine E-Mails über Margin durchsuchen und lesen, nur auf diesem Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, ChatGPT y otras apps compatibles con MCP pueden buscar y leer tu correo a través de Margin, solo en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, ChatGPT et les autres apps compatibles MCP peuvent rechercher et lire vos e-mails via Margin, sur ce Mac uniquement."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, ChatGPT et les autres apps compatibles avec MCP peuvent rechercher et lire vos courriels par l’intermédiaire de Margin, sur ce Mac seulement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, ChatGPT और MCP का समर्थन करने वाले अन्य ऐप Margin के ज़रिए आपका मेल खोज और पढ़ सकते हैं, सिर्फ़ इसी Mac पर।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Claude, a ChatGPT és más MCP-t támogató alkalmazások a Margin segítségével kereshetnek a leveleidben és olvashatják őket, kizárólag ezen a Macen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, ChatGPT e altre app che supportano MCP possono cercare e leggere la tua posta tramite Margin, solo su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
