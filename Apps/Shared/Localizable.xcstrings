        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yahoo necesita una contraseña de aplicación de los ajustes de seguridad de tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yahoo nécessite un mot de passe d’app, à créer dans les réglages de sécurité de votre compte."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
