          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yahoo にはアカウントのセキュリティ設定で作成した App パスワードが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
