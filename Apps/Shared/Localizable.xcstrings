    "Without a password the file isn't encrypted, so passwords and keys are left out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Passwort ist die Datei nicht verschlüsselt, daher werden Passwörter und Schlüssel weggelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin contraseña el archivo no se cifra, así que se omiten las contraseñas y las claves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans mot de passe, le fichier n’est pas chiffré : les mots de passe et les clés en sont donc exclus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans mot de passe, le fichier n’est pas chiffré; les mots de passe et les clés sont donc exclus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासवर्ड के बिना फ़ाइल एन्क्रिप्टेड नहीं होती, इसलिए पासवर्ड और कुंजियाँ शामिल नहीं की जातीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelszó nélkül a fájl nincs titkosítva, ezért a jelszavak és a kulcsok kimaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza una password il file non è cifrato, quindi password e chiavi vengono omesse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードがない場合、ファイルは暗号化されないため、パスワードとキーは含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호가 없으면 파일이 암호화되지 않으므로 암호와 키는 제외돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder wachtwoord wordt het bestand niet versleuteld, dus worden wachtwoorden en sleutels weggelaten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem senha, o arquivo não é criptografado, então senhas e chaves ficam de fora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без пароля файл не шифруется, поэтому пароли и ключи в него не включаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有密码，文件就不会加密，因此密码和密钥不会包含在内。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola olmadan dosya şifrelenmez; bu yüzden parolalar ve anahtarlar dahil edilmez."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有密碼時，檔案不會加密，因此不會包含密碼和金鑰。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez hasła plik nie jest szyfrowany, więc hasła i klucze są pomijane."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan lösenord krypteras inte filen, så lösenord och nycklar utelämnas."
          }
        }
      }
    },
