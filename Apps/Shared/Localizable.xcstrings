    "Only Google Workspace admins can list every room. Add a room by its address instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Google-Workspace-Admins können alle Räume auflisten. Füge stattdessen einen Raum über seine Adresse hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
