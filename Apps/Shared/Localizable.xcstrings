    "Pictures from the web in a signature often show as blocked for the people you write to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder aus dem Web in einer Signatur werden bei deinen Empfängern oft als blockiert angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes de la web en una firma suelen aparecer bloqueadas para quienes reciben tus mensajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images provenant du web dans une signature sont souvent bloquées chez vos destinataires."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images provenant du web dans une signature sont souvent bloquées chez vos destinataires."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हस्ताक्षर में वेब से लिए चित्र अक्सर उन लोगों को ब्लॉक किए हुए दिखते हैं जिन्हें आप लिखते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A weben lévő képek az aláírásban gyakran blokkoltként jelennek meg azoknál, akiknek írsz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le immagini dal web in una firma spesso risultano bloccate per chi riceve i tuoi messaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名にWebの画像を入れると、送信先ではブロックされて表示されることがよくあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명에 웹 사진을 넣으면 받는 사람에게 차단된 것으로 표시되는 경우가 많아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afbeeldingen van het web in een handtekening worden bij de mensen aan wie je schrijft vaak als geblokkeerd getoond."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagens da web em uma assinatura costumam aparecer bloqueadas para quem recebe seus e-mails."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изображения из интернета в подписи часто блокируются у тех, кому вы пишете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签名中的网络图片通常会被收件人的邮件程序拦截。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmzadaki web resimleri, yazdığınız kişilerde çoğu zaman engellenmiş olarak görünür."
