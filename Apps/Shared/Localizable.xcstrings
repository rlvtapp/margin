    "Sent by your provider while you're away, even when your devices are off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Anbieter sendet sie, während du weg bist, auch wenn deine Geräte aus sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu proveedor la envía mientras estás fuera, aunque tus dispositivos estén apagados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyée par votre fournisseur pendant votre absence, même quand vos appareils sont éteints."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyée par votre fournisseur pendant votre absence, même quand vos appareils sont éteints."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी गैरहाज़िरी में आपका प्रदाता भेजता है, डिवाइस बंद होने पर भी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szolgáltató küldi, amíg távol vagy, akkor is, ha az eszközeid ki vannak kapcsolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La invia il tuo provider mentre sei via, anche a dispositivi spenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不在中はプロバイダが送信します。デバイスの電源が切れていても届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부재 중에 제공업체가 보내며, 기기가 꺼져 있어도 보냅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuurd door je provider terwijl je weg bent, ook als je apparaten uit staan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviada pelo seu provedor enquanto você está fora, mesmo com os dispositivos desligados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Её отправляет провайдер, пока вас нет, даже если устройства выключены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开期间由邮件服务商发送，即使你的设备已关机。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz yokken, aygıtlarınız kapalı olsa bile sağlayıcınız tarafından gönderilir."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你離開期間由服務供應商寄出，即使你的裝置已關機也一樣。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłana przez Twojego dostawcę podczas Twojej nieobecności, nawet gdy Twoje urządzenia są wyłączone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickas av din leverantör medan du är borta, även när dina enheter är avstängda."
          }
        }
      }
    },
