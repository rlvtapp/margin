        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hun mail gaat direct naar de prullenmand."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os e-mails vão direto para o lixo."
          }
        },
