    "E, U, S, H and # work on the selection too. Esc clears it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E, U, S, H und # funktionieren auch für die Auswahl. Esc hebt sie auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E, U, S, H y # también funcionan con la selección. Esc la borra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E, U, S, H et # agissent aussi sur la sélection. Esc l’efface."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E, U, S, H et # s’appliquent aussi à la sélection. Esc l’efface."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E, U, S, H और # चयन पर भी काम करते हैं। Esc से चयन हट जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
