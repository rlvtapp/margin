    "Back up your settings, mailboxes and signatures on a schedule, locked with a password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere Einstellungen, Postfächer und Signaturen regelmäßig, geschützt mit einem Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz copias de tus ajustes, buzones y firmas de forma programada, protegidas con contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardez vos réglages, boîtes et signatures selon un horaire, protégés par un mot de passe."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardez vos paramètres, boîtes et signatures selon un horaire, protégés par un mot de passe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी सेटिंग्स, मेलबॉक्स और हस्ताक्षरों का तय समय पर बैकअप लें, पासवर्ड से सुरक्षित।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ments el a beállításaidat, postafiókjaidat és aláírásaidat ütemezetten, jelszóval védve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui il backup di impostazioni, caselle e firme a intervalli, protetto da password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定、メールボックス、署名を定期的にバックアップし、パスワードで保護します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정, 메일함, 서명을 일정에 따라 백업하고 암호로 잠급니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak volgens schema een reservekopie van je instellingen, mailboxen en handtekeningen, beveiligd met een wachtwoord."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça backup de ajustes, caixas e assinaturas de forma programada, protegido por senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервные копии настроек, ящиков и подписей по расписанию, под паролем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按计划备份你的设置、邮箱和签名,并用密码保护。"
          }
        }
      }
    },
