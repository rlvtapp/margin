    "%@ can answer questions but can't take actions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann Fragen beantworten, aber keine Aktionen ausführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ puede responder preguntas, pero no realizar acciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ peut répondre aux questions, mais pas effectuer d’actions."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
