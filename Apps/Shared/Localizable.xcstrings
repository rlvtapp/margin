    "To let the assistant make changes, turn on Allow changes in Settings → Assistant." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit der Assistent Änderungen vornehmen kann, schalte „Änderungen erlauben“ unter Einstellungen → Assistent ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que el asistente pueda hacer cambios, activa «Permitir cambios» en Ajustes → Asistente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour que l’assistant puisse faire des modifications, activez « Autoriser les modifications » dans Réglages → Assistant."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour que l’assistant puisse faire des modifications, activez « Autoriser les modifications » dans Réglages → Assistant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "असिस्टेंट को बदलाव करने देने के लिए, सेटिंग्ज़ → असिस्टेंट में “बदलावों की अनुमति दें” चालू करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha szeretnéd, hogy az asszisztens módosítson, kapcsold be a „Módosítások engedélyezése” lehetőséget a Beállítások → Asszisztens részben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per permettere all’assistente di fare modifiche, attiva “Consenti modifiche” in Impostazioni → Assistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アシスタントに変更を任せるには、設定 → アシスタントで「変更を許可」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어시스턴트가 변경할 수 있게 하려면 설정 → 어시스턴트에서 ‘변경 허용’을 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet ‘Wijzigingen toestaan’ aan in Instellingen → Assistent om de assistent wijzigingen te laten maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que o assistente possa fazer alterações, ative “Permitir alterações” em Ajustes → Assistente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы ассистент мог вносить изменения, включите «Разрешить изменения» в Настройки → Ассистент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要让助手进行更改，请在“设置 → 助手”中打开“允许更改”。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistanın değişiklik yapabilmesi için Ayarlar → Asistan bölümünde “Değişikliklere izin ver”i açın."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
