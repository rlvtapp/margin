    "Asks before sending when a message mentions an attachment but has none." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt vor dem Senden nach, wenn eine Nachricht einen Anhang erwähnt, aber keinen hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta antes de enviar si un mensaje menciona un adjunto pero no lo tiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande avant l’envoi quand un message mentionne une pièce jointe sans en avoir."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande avant l’envoi quand un message mentionne une pièce jointe sans en avoir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब संदेश में अटैचमेंट का ज़िक्र हो पर अटैचमेंट न हो, तो भेजने से पहले पूछता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küldés előtt rákérdez, ha az üzenet mellékletet említ, de nincs benne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede prima di inviare se un messaggio cita un allegato ma non ne ha."
