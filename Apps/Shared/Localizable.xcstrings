    "Added to %@, pointing at this copy of Margin. Move Margin to Applications and add it again, or it stops working when this copy is gone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu %1$@ hinzugefügt, mit Verweis auf diese Kopie von Margin. Bewege Margin in „Programme“ und füge es erneut hinzu, sonst funktioniert es nicht mehr, wenn diese Kopie weg ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadido a %1$@, apuntando a esta copia de Margin. Mueve Margin a Aplicaciones y vuelve a añadirlo, o dejará de funcionar cuando esta copia desaparezca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouté à %1$@, vers cette copie de Margin. Placez Margin dans Applications et ajoutez-le de nouveau, sinon il cessera de fonctionner quand cette copie disparaîtra."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouté à %1$@, vers cette copie de Margin. Placez Margin dans Applications et ajoutez-le de nouveau, sinon il cessera de fonctionner quand cette copie disparaîtra."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ में जोड़ा गया, Margin की इस कॉपी की ओर। Margin को Applications में ले जाकर फिर से जोड़ें, वरना यह कॉपी हटने पर काम बंद हो जाएगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hozzáadva ehhez: %1$@, a Margin ezen példányára mutatva. Tedd a Margint az Alkalmazások mappába és add hozzá újra, különben leáll, ha ez a példány eltűnik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunto a %1$@, puntando a questa copia di Margin. Sposta Margin in Applicazioni e aggiungilo di nuovo, o smetterà di funzionare quando questa copia non ci sarà più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ に追加しました（この Margin のコピーを参照）。Margin をアプリケーションに移動してからもう一度追加してください。このコピーがなくなると動かなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에 추가했습니다(이 Margin 사본을 가리킴). Margin을 응용 프로그램으로 옮긴 뒤 다시 추가하세요. 이 사본이 없어지면 작동하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegevoegd aan %1$@, met deze kopie van Margin. Zet Margin in Apps en voeg het opnieuw toe, anders werkt het niet meer als deze kopie weg is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionado ao %1$@, apontando para esta cópia do Margin. Mova o Margin para Aplicativos e adicione de novo, ou ele para de funcionar quando esta cópia sumir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавлено в %1$@ со ссылкой на эту копию Margin. Переместите Margin в «Программы» и добавьте снова, иначе всё перестанет работать, когда этой копии не станет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已添加到 %1$@，指向这份 Margin。请把 Margin 移到“应用程序”后重新添加，否则这份副本消失后将无法使用。"
          }
        }
      }
    },
