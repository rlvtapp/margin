    "This signature has formatting or pictures. Change it in Margin on a Mac, or make it plain to change the words here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Signatur hat Formatierung oder Bilder. Ändere sie in Margin auf einem Mac, oder mach sie zu reinem Text, um hier die Wörter zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta firma tiene formato o imágenes. Cámbiala en Margin en un Mac, o pásala a texto sin formato para cambiar el texto aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette signature a une mise en forme ou des images. Modifiez-la dans Margin sur un Mac, ou passez-la en texte brut pour changer le texte ici."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette signature a une mise en forme ou des images. Modifiez-la dans Margin sur un Mac, ou passez-la en texte brut pour changer le texte ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस हस्ताक्षर में फ़ॉर्मैटिंग या तस्वीरें हैं। इसे Mac पर Margin में बदलें, या यहाँ शब्द बदलने के लिए इसे सादा बनाएँ।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebben az aláírásban formázás vagy kép van. Módosítsd a Marginban egy Macen, vagy alakítsd egyszerű szöveggé, hogy itt írhasd át."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa firma ha formattazione o immagini. Modificala in Margin su un Mac, oppure rendila semplice per cambiare il testo qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この署名には書式や画像があります。MacのMarginで変更するか、書式を外してここで文字を変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서명에는 서식이나 사진이 있습니다. Mac의 Margin에서 바꾸거나, 일반 텍스트로 바꿔 여기서 내용을 수정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze handtekening heeft opmaak of afbeeldingen. Wijzig hem in Margin op een Mac, of maak er platte tekst van om hier de woorden te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten podpis ma formatowanie lub obrazy. Zmień go w Margin na Macu albo zamień na zwykły tekst, aby edytować go tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta assinatura tem formatação ou imagens. Altere-a no Margin em um Mac, ou torne-a simples para mudar o texto aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой подписи есть форматирование или изображения. Измените её в Margin на Mac или уберите форматирование, чтобы изменить текст здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här signaturen har formatering eller bilder. Ändra den i Margin på en Mac, eller gör den till ren text för att ändra orden här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu imzada biçimlendirme ya da resim var. Bir Mac'te Margin'de değiştir ya da burada metni değiştirmek için düz yap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此签名包含格式或图片。请在 Mac 上的 Margin 中修改，或转为纯文本以在此修改文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
