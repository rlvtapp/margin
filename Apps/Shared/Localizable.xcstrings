    "Haiku answers in about a second and is plenty for mail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku antwortet in etwa einer Sekunde und reicht für Mails völlig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku responde en un segundo más o menos y basta para el correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku répond en une seconde environ et suffit largement pour le courrier."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku répond en une seconde environ et suffit largement pour les courriels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku लगभग एक सेकंड में जवाब देता है और मेल के लिए काफ़ी है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Haiku nagyjából egy másodperc alatt válaszol, és levelekhez bőven elég."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku risponde in circa un secondo ed è più che sufficiente per la posta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku は約 1 秒で答え、メールには十分です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku는 약 1초 만에 답하며 메일에는 충분합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku antwoordt in ongeveer een seconde en is ruim genoeg voor mail."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Haiku responde em cerca de um segundo e é suficiente para e-mails."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku отвечает примерно за секунду, и для почты этого хватает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku 大约一秒就能回答,处理邮件足够了。"
          }
        }
      }
    },
    "Haiku: fastest and cheapest" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku: am schnellsten und günstigsten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiku: el más rápido y barato"
          }
        },
