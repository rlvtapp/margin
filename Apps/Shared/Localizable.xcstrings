        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyes szolgáltatók a címedet is elküldik; a továbbító csak egy felismerhetetlen változatát őrzi meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni provider inviano anche il tuo indirizzo; il relay ne conserva solo una forma irriconoscibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダによってはアドレスも送られますが、リレーは読み取れない形に変えたものだけを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 제공업체는 주소도 함께 보내지만, 릴레이는 알아볼 수 없게 바꾼 형태만 보관해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige providers sturen je adres mee; de relay bewaart daar alleen een onherkenbare vorm van."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns provedores enviam seu endereço junto; o relay guarda só uma forma embaralhada dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые провайдеры передают ваш адрес; ретранслятор хранит лишь его зашифрованный отпечаток."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些服务商会附上你的地址；中继只保留它无法还原的形式。"
