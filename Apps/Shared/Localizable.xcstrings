    "Other addresses this mailbox can send from. Your provider has to allow them. Replies to mail sent to one go out from it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere Adressen, von denen dieses Postfach senden kann. Dein Anbieter muss sie erlauben. Antworten auf E-Mails, die an eine davon gesendet wurden, gehen von dieser Adresse aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otras direcciones desde las que puede enviar este buzón. Tu proveedor tiene que permitirlas. Las respuestas al correo enviado a una de ellas salen desde esa dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autres adresses depuis lesquelles cette boîte aux lettres peut envoyer. Votre fournisseur doit les autoriser. Les réponses aux e-mails reçus sur l’une d’elles partent de cette adresse."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autres adresses depuis lesquelles cette boîte aux lettres peut envoyer. Votre fournisseur doit les autoriser. Les réponses aux courriels reçus sur l’une d’elles partent de cette adresse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अन्य पते जिनसे यह मेलबॉक्स भेज सकता है। आपके प्रदाता को इनकी अनुमति देनी होगी। इनमें से किसी पते पर भेजे गए मेल के जवाब उसी से जाते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "További címek, amelyekről ez a postafiók küldhet. A szolgáltatódnak engedélyeznie kell őket. Az ezekre érkezett levelekre adott válaszok onnan mennek ki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altri indirizzi da cui questa casella può inviare. Il tuo provider deve consentirli. Le risposte alla posta inviata a uno di questi partono da quell'indirizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメールボックスから送信できるほかのアドレスです。プロバイダ側で許可されている必要があります。いずれかのアドレス宛てのメールへの返信は、そのアドレスから送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 메일함에서 보낼 수 있는 다른 주소예요. 제공업체에서 허용해야 해요. 그 주소로 받은 메일에 대한 답장은 같은 주소로 나가요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere adressen waarmee deze mailbox kan versturen. Je provider moet ze toestaan. Antwoorden op e-mail die naar zo’n adres is gestuurd, gaan vanaf dat adres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outros endereços a partir dos quais esta caixa de correio pode enviar. Seu provedor precisa permiti-los. As respostas a e-mails enviados para um deles saem dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие адреса, с которых можно отправлять почту из этого ящика. Их должен разрешить ваш провайдер. Ответы на письма, отправленные на один из этих адресов, уходят с него."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此邮箱可用于发送的其他地址。需要你的服务商允许。发给其中某个地址的邮件，回复时会使用该地址发出。"
          }
        }
      }
    },
