    "You choose what they may change or send, and which mailboxes they see." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bestimmst, was sie ändern oder senden dürfen und welche Postfächer sie sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú decides qué pueden cambiar o enviar y qué buzones ven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous choisissez ce qu’elles peuvent modifier ou envoyer, et les boîtes qu’elles voient."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous choisissez ce qu’elles peuvent modifier ou envoyer, et les boîtes qu’elles voient."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप तय करते हैं कि वे क्या बदल या भेज सकते हैं, और कौन से मेलबॉक्स देखते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te döntöd el, mit módosíthatnak vagy küldhetnek, és mely postafiókokat látják."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli tu cosa possono modificare o inviare e quali caselle vedono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何を変更・送信してよいか、どのメールボックスを見せるかは自分で選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇을 바꾸거나 보낼 수 있는지, 어떤 메일함을 볼지 직접 정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij bepaalt wat ze mogen wijzigen of versturen en welke mailboxen ze zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
