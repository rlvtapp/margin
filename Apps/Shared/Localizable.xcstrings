    "Light emails without pictures turn dark with Margin. Emails with pictures sit on a white sheet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helle Mails ohne Bilder werden mit Margin dunkel. Mails mit Bildern liegen auf einem weißen Blatt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los correos claros sin imágenes se oscurecen con Margin. Los que tienen imágenes van sobre una hoja blanca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les e-mails clairs sans images deviennent sombres avec Margin. Ceux avec images restent sur une feuille blanche."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les courriels clairs sans images deviennent sombres avec Margin. Ceux avec images restent sur une feuille blanche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना तस्वीर वाले हल्के ईमेल Margin के साथ गहरे हो जाते हैं। तस्वीरों वाले ईमेल सफ़ेद पन्ने पर रहते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kép nélküli világos levelek a Marginnal együtt sötétek lesznek. A képes levelek fehér lapon maradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le email chiare senza immagini diventano scure con Margin. Quelle con immagini restano su un foglio bianco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像のない明るいメールはMarginに合わせて暗く。画像のあるメールは白い紙の上に表示。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 없는 밝은 메일은 Margin과 함께 어두워져요. 사진 있는 메일은 흰 종이 위에 놓여요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lichte mails zonder afbeeldingen worden donker met Margin. Mails met afbeeldingen staan op een wit vel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mails claros sem imagens ficam escuros com o Margin. Os com imagens ficam numa folha branca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Светлые письма без картинок темнеют вместе с Margin. Письма с картинками — на белом листе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有图片的浅色邮件会随 Margin 变暗。带图片的邮件显示在白色底上。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resim içermeyen açık renkli e-postalar Margin ile koyulaşır. Resimli e-postalar beyaz bir sayfa üzerinde durur."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有圖片的淺色郵件會隨 Margin 變成深色。含圖片的郵件則顯示在白色底上。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasne wiadomości bez obrazków stają się w Margin ciemne. Wiadomości z obrazkami leżą na białym arkuszu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljusa mejl utan bilder blir mörka med Margin. Mejl med bilder ligger på ett vitt ark."
          }
        }
      }
    },
