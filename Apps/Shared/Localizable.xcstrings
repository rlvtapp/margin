          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールはこのデバイスとメールプロバイダの間で直接やり取りされます。パスワードとトークンはこのデバイスのキーチェーンに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
