    "Press H to snooze a conversation; it comes back to the inbox at the time you pick." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück H, um eine Konversation zurückzustellen; sie kommt zur gewählten Zeit zurück in den Posteingang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa H para posponer una conversación; vuelve a la bandeja de entrada a la hora que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur H pour mettre une conversation en attente ; elle revient dans la boîte de réception à l’heure choisie."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur H pour mettre une conversation en attente ; elle revient dans la boîte de réception à l’heure choisie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी बातचीत को स्नूज़ करने के लिए H दबाएँ; वह आपके चुने समय पर इनबॉक्स में लौट आती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyomd meg a H-t egy beszélgetés elhalasztásához; a választott időben visszakerül a beérkezett levelek közé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi H per posticipare una conversazione; torna nella posta in arrivo all’ora che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H を押すと会話をスヌーズでき、選んだ時刻に受信箱へ戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H를 눌러 대화를 다시 알림으로 미루면, 고른 시간에 받은편지함으로 돌아옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk op H om een gesprek uit te stellen; het komt terug in de inbox op het tijdstip dat je kiest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione H para adiar uma conversa; ela volta à caixa de entrada no horário escolhido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите H, чтобы отложить переписку; она вернётся во входящие в выбранное время."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 H 可延后会话,它会在你选择的时间回到收件箱。"
          }
        }
      }
    },
