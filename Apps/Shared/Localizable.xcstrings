    "While writing, hold the space bar and speak. A short press is still a space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte beim Schreiben die Leertaste gedrückt und sprich. Kurzes Drücken bleibt ein Leerzeichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras escribes, mantén pulsada la barra espaciadora y habla. Una pulsación corta sigue siendo un espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant que vous écrivez, maintenez la barre d’espace et parlez. Un appui bref reste une espace."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant que vous écrivez, maintenez la barre d’espace et parlez. Un appui bref reste une espace."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao escrever, segure a barra de espaço e fale. Um toque curto continua sendo um espaço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写邮件时按住空格键并说话。短按仍然输入空格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫郵件時按住空白鍵並說話。短按仍然輸入空格。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिखते समय स्पेस बार दबाए रखें और बोलें। छोटा दबाव अब भी स्पेस ही है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írás közben tartsd lenyomva a szóközt, és beszélj. A rövid lenyomás továbbra is szóköz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre scrivi, tieni premuta la barra spaziatrice e parla. Una pressione breve resta uno spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力中にスペースキーを長押しして話します。短く押すと通常どおりスペースが入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작성 중에 스페이스 바를 길게 누르고 말하세요. 짧게 누르면 그대로 띄어쓰기입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd tijdens het schrijven de spatiebalk ingedrukt en spreek. Kort drukken blijft een spatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas pisania przytrzymaj spację i mów. Krótkie naciśnięcie to nadal spacja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время письма удерживайте пробел и говорите. Короткое нажатие по-прежнему ставит пробел."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned mellanslag medan du skriver och tala. Ett kort tryck är fortfarande ett mellanslag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazarken boşluk tuşunu basılı tutup konuş. Kısa basış yine boşluk bırakır."
          }
        }
      }
    },
