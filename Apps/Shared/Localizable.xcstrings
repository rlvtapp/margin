    "Hi Alex, the flat by the river is free in May. Shall I book it?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo Alex, die Wohnung am Fluss ist im Mai frei. Soll ich sie buchen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola Alex, el piso junto al río está libre en mayo. ¿Lo reservo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour Alex, l’appartement au bord du fleuve est libre en mai. Je le réserve ?"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour Alex, l’appartement au bord du fleuve est libre en mai. Je le réserve?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते Alex, नदी किनारे वाला फ़्लैट मई में खाली है। बुक कर दूँ?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szia Alex, a folyóparti lakás májusban szabad. Lefoglaljam?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao Alex, l’appartamento sul fiume è libero a maggio. Lo prenoto?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alexさん、川沿いの部屋が5月に空いています。予約しましょうか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요 Alex, 강가 숙소가 5월에 비어 있어요. 예약할까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi Alex, het appartement aan de rivier is in mei vrij. Zal ik het boeken?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi Alex, o apartamento perto do rio está livre em maio. Posso reservar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет, Алекс! Квартира у реки свободна в мае. Бронировать?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好 Alex，河边那套公寓五月有空。要我订吗？"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba Alex, nehir kenarındaki daire mayısta boş. Ayırtayım mı?"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alex 你好，河邊那間公寓五月有空。要幫你預訂嗎？"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć Alex, mieszkanie nad rzeką jest wolne w maju. Mam je zarezerwować?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hej Alex, lägenheten vid floden är ledig i maj. Ska jag boka den?"
          }
        }
      }
    },
    "Hi {first_name},\n\nThanks for thinking of me. I can't take this on right now, but please keep me in mind for later.\n\nBest,\n{my_first_name}" : {
      "comment" : "Starter template; keep the {…} fill-ins as they are",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo {first_name},\n\nvielen Dank, dass du an mich gedacht hast. Ich kann das gerade nicht übernehmen, aber behalte mich gern für später im Hinterkopf.\n\nViele Grüße\n{my_first_name}"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola, {first_name}:\n\nGracias por pensar en mí. Ahora mismo no puedo ocuparme de esto, pero cuenta conmigo para más adelante.\n\nUn saludo,\n{my_first_name}"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour {first_name},\n\nMerci d’avoir pensé à moi. Je ne peux pas m’en charger pour le moment, mais n’hésitez pas à me recontacter plus tard.\n\nBien à vous,\n{my_first_name}"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour {first_name},\n\nMerci d’avoir pensé à moi. Je ne peux pas m’en charger pour le moment, mais n’hésitez pas à penser à moi pour plus tard.\n\nCordialement,\n{my_first_name}"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते {first_name},\n\nमेरे बारे में सोचने के लिए धन्यवाद। मैं अभी इसे नहीं ले पाऊँगा/पाऊँगी, पर कृपया आगे के लिए मुझे याद रखें।\n\nसादर,\n{my_first_name}"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szia, {first_name}!\n\nKöszi, hogy gondoltál rám. Most nem tudom bevállalni, de kérlek, tarts észben a későbbiekre.\n\nÜdv,\n{my_first_name}"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao {first_name},\n\ngrazie per aver pensato a me. In questo momento non posso occuparmene, ma tienimi presente per il futuro.\n\nUn saluto,\n{my_first_name}"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{first_name} 様\n\nお声がけいただきありがとうございます。今はお引き受けできませんが、また機会があればぜひお声がけください。\n\nよろしくお願いいたします。\n{my_first_name}"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{first_name} 님께,\n\n생각해 주셔서 고마워요. 지금은 맡기 어렵지만, 나중에 다시 떠올려 주세요.\n\n감사합니다.\n{my_first_name}"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi {first_name},\n\nBedankt dat je aan me dacht. Ik kan dit nu niet oppakken, maar houd me gerust in gedachten voor later.\n\nGroet,\n{my_first_name}"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá, {first_name},\n\nObrigado por pensar em mim. Não posso assumir isso agora, mas por favor me lembre mais adiante.\n\nAbraços,\n{my_first_name}"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здравствуйте, {first_name}!\n\nСпасибо, что вспомнили обо мне. Сейчас я не смогу за это взяться, но, пожалуйста, имейте меня в виду на будущее.\n\nВсего доброго,\n{my_first_name}"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{first_name}，你好：\n\n谢谢你想到我。我现在没法接手这件事，不过之后请再考虑我。\n\n祝好，\n{my_first_name}"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba {first_name},\n\nBeni düşündüğünüz için teşekkürler. Şu anda bunu üstlenemiyorum ama lütfen ileride beni aklınızda tutun.\n\nSevgiler,\n{my_first_name}"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{first_name} 你好：\n\n謝謝你想到我。我目前沒辦法接下這件事，但之後請再考慮我。\n\n祝好\n{my_first_name}"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć {first_name},\n\ndziękuję, że o mnie pamiętasz. Nie mogę się teraz tego podjąć, ale proszę, miej mnie na uwadze w przyszłości.\n\nPozdrawiam\n{my_first_name}"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hej {first_name}!\n\nTack för att du tänkte på mig. Jag kan inte ta på mig det här just nu, men tänk gärna på mig längre fram.\n\nVänliga hälsningar\n{my_first_name}"
          }
        }
      }
    },
    "Hi {first_name},\n\nThanks for this, much appreciated.\n\n{my_first_name}" : {
      "comment" : "Starter template; keep the {…} fill-ins as they are",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo {first_name},\n\nvielen Dank dafür, ich weiß das sehr zu schätzen.\n\n{my_first_name}"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola, {first_name}:\n\nGracias por esto, te lo agradezco mucho.\n\n{my_first_name}"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour {first_name},\n\nMerci beaucoup, c’est très apprécié.\n\n{my_first_name}"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour {first_name},\n\nMerci pour ceci, c’est très apprécié.\n\n{my_first_name}"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते {first_name},\n\nइसके लिए धन्यवाद, बहुत आभारी हूँ।\n\n{my_first_name}"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szia, {first_name}!\n\nKöszönöm, nagyon hálás vagyok.\n\n{my_first_name}"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao {first_name},\n\ngrazie per questo, lo apprezzo molto.\n\n{my_first_name}"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{first_name} 様\n\nありがとうございます。大変助かります。\n\n{my_first_name}"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{first_name} 님께,\n\n보내 주셔서 정말 고마워요.\n\n{my_first_name}"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi {first_name},\n\nBedankt hiervoor, ik waardeer het zeer.\n\n{my_first_name}"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá, {first_name},\n\nObrigado por isso, fico muito grato.\n\n{my_first_name}"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здравствуйте, {first_name}!\n\nСпасибо, очень ценю.\n\n{my_first_name}"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{first_name}，你好：\n\n谢谢你，非常感谢。\n\n{my_first_name}"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba {first_name},\n\nBunun için teşekkürler, çok makbule geçti.\n\n{my_first_name}"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{first_name} 你好：\n\n謝謝你，非常感激。\n\n{my_first_name}"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć {first_name},\n\ndzięki, bardzo to doceniam.\n\n{my_first_name}"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hej {first_name}!\n\nTack för det här, jag uppskattar det verkligen.\n\n{my_first_name}"
          }
        }
      }
    },
    "Hi,\n\nJust following up on this. Did you have a chance to take a look?\n\n" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo,\n\nich möchte kurz nachfassen. Hattest du schon Gelegenheit, einen Blick darauf zu werfen?\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola:\n\nTe escribo para retomar este tema. ¿Has tenido ocasión de echarle un vistazo?\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour,\n\nJe me permets de revenir vers vous à ce sujet. Avez-vous eu l’occasion d’y jeter un œil ?\n\n"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour,\n\nJe fais un suivi à ce sujet. Avez-vous eu l’occasion d’y jeter un œil?\n\n"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते,\n\nबस इसी बारे में फ़ॉलो-अप कर रहा/रही हूँ। क्या आपको इसे देखने का मौका मिला?\n\n"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szia!\n\nCsak érdeklődöm ezzel kapcsolatban. Volt időd megnézni?\n\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao,\n\nti scrivo per un sollecito su questo. Hai avuto modo di dare un'occhiata?\n\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは。\n\nこの件について確認のご連絡です。ご覧いただけましたでしょうか?\n\n"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요,\n\n이 건으로 다시 연락드려요. 한번 살펴보실 시간이 있었나요?\n\n"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi,\n\nIk kom hier nog even op terug. Heb je al kans gehad om ernaar te kijken?\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá,\n\nSó estou acompanhando isto. Você teve a chance de dar uma olhada?\n\n"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здравствуйте!\n\nХочу уточнить, что с этим вопросом. Удалось ли вам посмотреть?\n\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好：\n\n想跟进一下这件事。你有时间看一下吗？\n\n"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba,\n\nBu konuyu hatırlatmak istedim. Göz atma fırsatınız oldu mu?\n\n"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好：\n\n想跟進一下這件事，不知道你有空看看了嗎？\n\n"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć,\n\nwracam do tej sprawy. Czy udało Ci się już na to zerknąć?\n\n"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hej!\n\nJag ville bara följa upp det här. Har du hunnit titta på det?\n\n"
          }
        }
      }
    },
    "Hidden pictures that report back are removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteckte Bilder, die etwas zurückmelden, werden entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitan las imágenes ocultas que informan al remitente."
          }
        },
        "fr" : {
