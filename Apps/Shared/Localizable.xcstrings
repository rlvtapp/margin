    "Answers come in as people reply, and straight from Microsoft 365 or Google when the account's calendar is connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten kommen mit den Rückmeldungen und direkt von Microsoft 365 oder Google, wenn der Kalender des Kontos verbunden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas llegan cuando la gente contesta, y directamente de Microsoft 365 o Google si el calendario de la cuenta está conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses arrivent quand les gens répondent, et directement de Microsoft 365 ou Google si le calendrier du compte est connecté."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses arrivent quand les gens répondent, et directement de Microsoft 365 ou Google si le calendrier du compte est connecté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जवाब लोगों के रिप्लाई के साथ आते हैं, और खाते का कैलेंडर जुड़ा हो तो सीधे Microsoft 365 या Google से।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A válaszok a visszajelzésekkel érkeznek, csatlakoztatott naptárnál pedig közvetlenül a Microsoft 365-ből vagy a Google-ból."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte arrivano man mano che le persone rispondono, e direttamente da Microsoft 365 o Google se il calendario dell'account è collegato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答は返信が届くたびに反映され、アカウントのカレンダーを接続していれば Microsoft 365 や Google から直接届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답장이 오는 대로 반영되며, 계정 캘린더가 연결되어 있으면 Microsoft 365나 Google에서 바로 가져옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwoorden komen binnen zodra mensen reageren, en direct uit Microsoft 365 of Google als de agenda van het account gekoppeld is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas chegam conforme as pessoas respondem, e direto do Microsoft 365 ou Google quando o calendário da conta está conectado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответы приходят вместе с письмами участников, а при подключённом календаре — прямо из Microsoft 365 или Google."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "答复会随回信更新；如果连接了账户的日历，也会直接从 Microsoft 365 或 Google 获取。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanıtlar kişiler cevap verdikçe gelir; hesabın takvimi bağlıysa doğrudan Microsoft 365 veya Google’dan da gelir."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對方回信時就會更新回覆；若已連接帳號的行事曆，也會直接從 Microsoft 365 或 Google 取得。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedzi pojawiają się, gdy ludzie odpisują, a także bezpośrednio z Microsoft 365 lub Google, gdy kalendarz konta jest połączony."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar kommer in när personer svarar, och direkt från Microsoft 365 eller Google när kontots kalender är ansluten."
          }
        }
      }
    },
