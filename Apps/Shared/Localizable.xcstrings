    "%@ reads up to 40 of your recent sent emails per language, once, and describes how you write: tone, sentence length, words you use. Only the description is kept, and every draft follows it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liest einmalig bis zu 40 deiner zuletzt gesendeten E-Mails pro Sprache und beschreibt, wie du schreibst: Ton, Satzlänge, deine Wörter. Nur die Beschreibung wird behalten, und jeder Entwurf folgt ihr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lee una vez hasta 40 de tus correos enviados recientes por idioma y describe cómo escribes: tono, longitud de las frases, palabras que usas. Solo se guarda la descripción, y cada borrador la sigue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lit une fois jusqu’à 40 de vos courriels envoyés récents par langue et décrit votre façon d’écrire : ton, longueur des phrases, mots employés. Seule la description est conservée, et chaque brouillon la suit."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lit une fois jusqu’à 40 de vos courriels envoyés récents par langue et décrit votre façon d’écrire : ton, longueur des phrases, mots employés. Seule la description est conservée, et chaque brouillon la suit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ हर भाषा में आपके हाल में भेजे गए अधिकतम 40 ईमेल एक बार पढ़ता है और बताता है कि आप कैसे लिखते हैं: लहजा, वाक्य की लंबाई, आपके शब्द। सिर्फ़ विवरण रखा जाता है, और हर ड्राफ़्ट उसी के अनुसार लिखा जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ nyelvenként legfeljebb 40 nemrég elküldött e-mailedet egyszer elolvassa, és leírja, hogyan írsz: hangnem, mondathossz, szavaid. Csak a leírás marad meg, és minden piszkozat ezt követi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ legge una volta fino a 40 email inviate di recente per lingua e descrive come scrivi: tono, lunghezza delle frasi, parole che usi. Si conserva solo la descrizione, e ogni bozza la segue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が言語ごとに最近送信したメールを最大 40 件、一度だけ読み、あなたの書き方(口調、文の長さ、よく使う言葉)を説明します。残るのは説明だけで、すべての下書きがそれに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 언어별로 최근 보낸 이메일을 최대 40개 한 번 읽고 글쓰기 방식(어조, 문장 길이, 자주 쓰는 단어)을 설명합니다. 설명만 보관되며 모든 초안이 이를 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ leest per taal eenmalig tot 40 van je recent verstuurde e-mails en beschrijft hoe je schrijft: toon, zinslengte, woorden die je gebruikt. Alleen de beschrijving wordt bewaard, en elk concept volgt die."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lê uma vez até 40 dos seus e-mails enviados recentes por idioma e descreve como você escreve: tom, tamanho das frases, palavras que usa. Só a descrição é guardada, e cada rascunho a segue."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ один раз читает до 40 недавно отправленных писем на каждом языке и описывает, как вы пишете: тон, длину предложений, ваши слова. Сохраняется только описание, и каждый черновик следует ему."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会按语言读取你最近发送的最多 40 封邮件(仅一次),并描述你的写作方式:语气、句子长度、常用词。只保留这段描述,每份草稿都会照着写。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ her dil için son gönderdiğiniz en fazla 40 e-postayı bir kez okur ve nasıl yazdığınızı anlatır: ton, cümle uzunluğu, kullandığınız kelimeler. Yalnızca bu açıklama saklanır ve her taslak ona uyar."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 會按語言讀取你最近傳送的最多 40 封郵件(僅一次),並描述你的寫作方式:語氣、句子長度、常用詞。只保留這段描述,每份草稿都會照著寫。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jednorazowo czyta do 40 ostatnio wysłanych e-maili w każdym języku i opisuje, jak piszesz: ton, długość zdań, używane słowa. Zachowywany jest tylko opis, a każdy szkic się do niego stosuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läser en gång upp till 40 av dina senast skickade mejl per språk och beskriver hur du skriver: ton, meningslängd, ord du använder. Bara beskrivningen sparas, och varje utkast följer den."
          }
        }
      }
    },
