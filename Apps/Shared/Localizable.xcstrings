    "Short back-and-forth reads as bubbles instead of a stack of emails." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzes Hin und Her erscheint als Blasen statt als Mailstapel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conversaciones cortas se leen como burbujas en vez de una pila de correos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les échanges courts s’affichent en bulles plutôt qu’en pile d’e-mails."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les échanges courts s’affichent en bulles plutôt qu’en pile de courriels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटी बातचीत ईमेल के ढेर के बजाय बुलबुलों में दिखती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rövid oda-vissza buborékokként jelenik meg levélhalom helyett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I brevi scambi si leggono come fumetti invece che come una pila di email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短いやりとりはメールの束ではなく吹き出しで表示。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧은 대화는 메일 묶음 대신 말풍선으로 보여요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kort heen-en-weer leest als bubbels in plaats van een stapel mails."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocas curtas aparecem como balões em vez de uma pilha de e-mails."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткая переписка — пузырями, а не стопкой писем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简短的往来以气泡显示，而不是一叠邮件。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa karşılıklı yazışmalar, e-posta yığını yerine baloncuklar olarak görünür."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡短的你來我往會以對話泡泡顯示，而不是一疊郵件。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krótka wymiana zdań wyświetla się jako dymki zamiast stosu wiadomości."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korta meddelanden fram och tillbaka visas som bubblor i stället för en hög med mejl."
          }
        }
      }
    },
