    "As the sender designed it, without scripts. Pictures from the web wait until you allow them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So, wie der Absender sie gestaltet hat, ohne Skripte. Bilder aus dem Web warten, bis du sie erlaubst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como lo diseñó el remitente, sin scripts. Las imágenes de la web esperan a que las permitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel que l’expéditeur l’a conçu, sans scripts. Les images du web attendent votre accord."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel que l’expéditeur l’a conçu, sans scripts. Les images du Web attendent votre accord."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जैसा भेजने वाले ने डिज़ाइन किया, बिना स्क्रिप्ट। वेब की तस्वीरें आपकी अनुमति तक रुकी रहती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahogy a feladó megtervezte, szkriptek nélkül. A webes képek az engedélyedig várnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come l’ha progettata il mittente, senza script. Le immagini dal web aspettano il tuo permesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "差出人のデザインどおり、スクリプトなしで。Webの画像は許可するまで表示しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보낸 사람이 디자인한 그대로, 스크립트 없이. 웹 사진은 허용할 때까지 기다려요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoals de afzender het ontwierp, zonder scripts. Afbeeldingen van het web wachten tot je ze toestaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o remetente criou, sem scripts. Imagens da web esperam sua permissão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как задумал отправитель, без скриптов. Картинки из интернета — только с вашего разрешения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按发件人的设计显示，不运行脚本。网络图片要等你允许才加载。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderenin tasarladığı gibi, betikler olmadan. Web’deki resimler siz izin verene kadar yüklenmez."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依寄件人設計的樣子顯示，但不執行指令碼。網路上的圖片會等你允許後才載入。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak, jak zaprojektował ją nadawca, bez skryptów. Obrazki z internetu czekają, aż na nie zezwolisz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som avsändaren utformade det, utan skript. Bilder från webben väntar tills du tillåter dem."
          }
        }
      }
    },
