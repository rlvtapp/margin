    "Proton Mail works through Proton Mail Bridge on this Mac. Use the password Bridge shows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail funktioniert über Proton Mail Bridge auf diesem Mac. Verwende das Passwort, das Bridge anzeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail funciona con Proton Mail Bridge en este Mac. Usa la contraseña que muestra Bridge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail fonctionne via Proton Mail Bridge sur ce Mac. Utilisez le mot de passe affiché par Bridge."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail fonctionne par l’intermédiaire de Proton Mail Bridge sur ce Mac. Utilisez le mot de passe affiché par Bridge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail इस Mac पर Proton Mail Bridge के ज़रिए काम करता है। Bridge जो पासवर्ड दिखाए, वही इस्तेमाल करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Proton Mail ezen a Macen a Proton Mail Bridge-en keresztül működik. Használd a Bridge által mutatott jelszót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail funziona tramite Proton Mail Bridge su questo Mac. Usa la password che mostra Bridge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail はこの Mac 上の Proton Mail Bridge を通じて利用します。Bridge に表示されるパスワードを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail은 이 Mac의 Proton Mail Bridge를 통해 작동해요. Bridge에 표시된 암호를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail werkt via Proton Mail Bridge op deze Mac. Gebruik het wachtwoord dat Bridge toont."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Proton Mail funciona pelo Proton Mail Bridge neste Mac. Use a senha que o Bridge mostra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail работает через Proton Mail Bridge на этом Mac. Используйте пароль, который показывает Bridge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proton Mail 通过这台 Mac 上的 Proton Mail Bridge 工作。请使用 Bridge 显示的密码。"
          }
        }
      }
