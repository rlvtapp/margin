          }
        }
      }
    },
    "If a mailbox stops signing in, choose Sign In Again from its menu. Your mail and settings stay as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich ein Postfach nicht mehr anmeldet, wähle in seinem Menü „Erneut anmelden“. Deine Mails und Einstellungen bleiben, wie sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un buzón deja de iniciar sesión, elige Volver a iniciar sesión en su menú. Tu correo y tus ajustes se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une boîte ne se connecte plus, choisissez Se reconnecter dans son menu. Vos e-mails et vos réglages restent tels quels."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une boîte ne se connecte plus, choisissez Se reconnecter dans son menu. Vos courriels et vos réglages restent tels quels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर कोई मेलबॉक्स साइन इन करना बंद कर दे, तो उसके मेनू से फिर से साइन इन करें चुनें। आपकी मेल और सेटिंग्स जैसी हैं वैसी ही रहती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha egy postafiók már nem tud bejelentkezni, válaszd a menüjéből a Bejelentkezés újra lehetőséget. A leveleid és a beállításaid változatlanok maradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se una casella non riesce più ad accedere, scegli Accedi di nuovo dal suo menu. La posta e le impostazioni restano come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールボックスがサインインできなくなったら、そのメニューから「もう一度サインイン」を選んでください。メールと設定はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일함이 더 이상 로그인되지 않으면 해당 메뉴에서 다시 로그인을 선택하세요. 메일과 설정은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als een mailbox niet meer inlogt, kies dan Opnieuw inloggen in het menu ervan. Je mail en instellingen blijven zoals ze zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se uma caixa de correio parar de entrar, escolha Entrar novamente no menu dela. Seus e-mails e ajustes ficam como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ящик перестал входить, выберите в его меню «Войти снова». Почта и настройки останутся как есть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果某个邮箱无法再登录，请在它的菜单中选择“重新登录”。你的邮件和设置保持不变。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir posta kutusu giriş yapamaz olursa menüsünden Yeniden giriş yap’ı seç. Postaların ve ayarların olduğu gibi kalır."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果某個信箱無法再登入，請在它的選單中選擇「重新登入」。你的郵件和設定保持不變。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli skrzynka przestanie się logować, wybierz z jej menu Zaloguj się ponownie. Poczta i ustawienia zostają bez zmian."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om en brevlåda slutar logga in väljer du Logga in igen i dess meny. Din e-post och dina inställningar ligger kvar som de är."
          }
        }
      }
    },
