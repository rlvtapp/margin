        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt Codex auf diesem Mac mit deiner eigenen Anmeldung. Die Konversation, nach der du fragst, geht an OpenAI; nichts läuft über Margin. Jede Antwort dauert ein paar Sekunden."
          }
        },
        "es" : {
