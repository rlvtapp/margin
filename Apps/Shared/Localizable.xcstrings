        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yahoo को आपके खाते की सुरक्षा सेटिंग से बनाया गया ऐप पासवर्ड चाहिए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
