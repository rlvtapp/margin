    "iCloud needs an app-specific password, made at account.apple.com." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud braucht ein App-spezifisches Passwort, das du unter account.apple.com erstellst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud necesita una contraseña específica de app, que se crea en account.apple.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud nécessite un mot de passe pour app, à créer sur account.apple.com."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud exige un mot de passe pour app, à créer sur account.apple.com."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud को ऐप-विशिष्ट पासवर्ड चाहिए, जो account.apple.com पर बनता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iCloud-hoz alkalmazásspecifikus jelszó kell, amit az account.apple.com oldalon hozhatsz létre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud richiede una password specifica per app, creata su account.apple.com."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud には App 用パスワードが必要です。account.apple.com で作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에는 account.apple.com에서 만드는 앱 암호가 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud heeft een appspecifiek wachtwoord nodig. Maak er een aan op account.apple.com."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud exige uma senha específica de app, criada em account.apple.com."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для iCloud нужен пароль для приложения, созданный на account.apple.com."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 需要 App 专用密码，请在 account.apple.com 创建。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud, account.apple.com adresinde oluşturulan uygulamaya özel bir parola gerektirir."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 需要 App 專用密碼，請在 account.apple.com 製作。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud wymaga hasła dla aplikacji, które tworzy się na account.apple.com."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud kräver ett appspecifikt lösenord som du skapar på account.apple.com."
          }
        }
      }
    },
