    "Inboxes in this workspace without signatures of their own use these in place of the ones for all inboxes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postfächer in diesem Arbeitsbereich ohne eigene Signaturen verwenden diese statt der für alle Postfächer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las bandejas de este espacio de trabajo sin firmas propias usan estas en lugar de las de todas las bandejas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boîtes de cet espace de travail sans signatures propres utilisent celles-ci au lieu de celles de toutes les boîtes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boîtes de cet espace de travail sans signatures propres utilisent celles-ci au lieu de celles de toutes les boîtes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस वर्कस्पेस के जिन इनबॉक्स के अपने हस्ताक्षर नहीं हैं, वे सभी इनबॉक्स वाले हस्ताक्षरों की जगह इन्हें उपयोग करते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A munkaterület saját aláírás nélküli postafiókjai ezeket használják az összes postafiókhoz tartozók helyett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le caselle di questo spazio di lavoro senza firme proprie usano queste al posto di quelle per tutte le caselle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このワークスペースで独自の署名がない受信箱は、すべての受信箱用の署名の代わりにこれらを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업 공간에서 자체 서명이 없는 받은편지함은 모든 받은편지함용 서명 대신 이 서명을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
