    "%@ is a free mail app. It connects directly to your mail provider over IMAP, SMTP and JMAP. There is no server of ours in between, no account to make, and nothing is tracked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein kostenloses Mailprogramm. Es verbindet sich direkt über IMAP, SMTP und JMAP mit deinem Mail-Anbieter. Es gibt keinen Server von uns dazwischen, kein Konto, das du anlegen musst, und nichts wird verfolgt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una app de correo gratuita. Se conecta directamente con tu proveedor de correo mediante IMAP, SMTP y JMAP. No hay ningún servidor nuestro de por medio, no hay que crear una cuenta y no se rastrea nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est une app de messagerie gratuite. Elle se connecte directement à votre fournisseur de messagerie via IMAP, SMTP et JMAP. Aucun serveur à nous entre les deux, aucun compte à créer, et rien n’est suivi."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est une app de courriel gratuite. Elle se connecte directement à votre fournisseur de courriel par IMAP, SMTP et JMAP. Aucun serveur à nous entre les deux, aucun compte à créer et aucun suivi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ एक मुफ़्त मेल ऐप है। यह IMAP, SMTP और JMAP के ज़रिए सीधे आपके मेल प्रदाता से जुड़ता है। बीच में हमारा कोई सर्वर नहीं है, कोई खाता बनाने की ज़रूरत नहीं है, और कुछ भी ट्रैक नहीं किया जाता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ ingyenes levelezőalkalmazás. IMAP-on, SMTP-n és JMAP-on keresztül közvetlenül a levelezőszolgáltatódhoz csatlakozik. Nincs köztünk szerver, nem kell fiókot létrehoznod, és semmit sem követünk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un'app di posta gratuita. Si collega direttamente al tuo provider di posta tramite IMAP, SMTP e JMAP. Non c'è nessun nostro server in mezzo, non serve creare un account e non viene tracciato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は無料のメールアプリです。IMAP、SMTP、JMAP でメールプロバイダに直接接続します。間に当社のサーバはなく、アカウントの作成も不要で、何も追跡されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 무료 메일 앱이에요. IMAP, SMTP, JMAP으로 메일 제공업체에 바로 연결돼요. 중간에 저희 서버가 없고, 계정을 만들 필요도 없으며, 아무것도 추적하지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is een gratis mailapp. Het maakt via IMAP, SMTP en JMAP rechtstreeks verbinding met je e-mailprovider. Er zit geen server van ons tussen, je hoeft geen account aan te maken en er wordt niets gevolgd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ é um app de e-mail gratuito. Ele se conecta diretamente ao seu provedor de e-mail por IMAP, SMTP e JMAP. Não há nenhum servidor nosso no meio, não é preciso criar conta e nada é rastreado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — бесплатная почтовая программа. Она подключается напрямую к вашему почтовому провайдеру по IMAP, SMTP и JMAP. Между ними нет нашего сервера, не нужно создавать учётную запись, и ничего не отслеживается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是一款免费的邮件 App。它通过 IMAP、SMTP 和 JMAP 直接连接你的邮件服务商。中间没有我们的服务器，无需注册账户，也不会追踪任何内容。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ücretsiz bir posta uygulamasıdır. IMAP, SMTP ve JMAP üzerinden doğrudan posta sağlayıcınıza bağlanır. Arada bize ait bir sunucu yoktur, hesap oluşturmanız gerekmez ve hiçbir şey izlenmez."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是一款免費的郵件 App，透過 IMAP、SMTP 和 JMAP 直接連線到你的郵件服務供應商。中間沒有我們的伺服器，不需註冊帳號，也不會追蹤任何內容。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to darmowa aplikacja pocztowa. Łączy się bezpośrednio z Twoim dostawcą poczty przez IMAP, SMTP i JMAP. Nie ma pośrodku żadnego naszego serwera, nie trzeba zakładać konta i nic nie jest śledzone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är en gratis e-postapp. Den ansluter direkt till din e-postleverantör via IMAP, SMTP och JMAP. Det finns ingen server från oss emellan, inget konto att skapa och ingenting spåras."
          }
        }
      }
    },
