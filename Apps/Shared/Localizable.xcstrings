    "Add a logo or photo with the picture button. Pictures go along with the mail, so nobody has to load them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge mit der Bildtaste ein Logo oder Foto hinzu. Bilder werden mit der Mail mitgeschickt, damit niemand sie laden muss."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un logotipo o una foto con el botón de imagen. Las imágenes viajan con el correo, así nadie tiene que cargarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un logo ou une photo avec le bouton d'image. Les images partent avec le courriel, personne n'a besoin de les charger."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un logo ou une photo avec le bouton d'image. Les images partent avec le courriel, personne n'a besoin de les charger."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तस्वीर बटन से लोगो या फ़ोटो जोड़ें। तस्वीरें मेल के साथ जाती हैं, इसलिए किसी को उन्हें लोड नहीं करना पड़ता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logót vagy fotót a kép gombbal adhatsz hozzá. A képek a levéllel együtt mennek, így senkinek sem kell betöltenie őket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un logo o una foto con il pulsante immagine. Le immagini viaggiano con la mail, così nessuno deve caricarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像ボタンでロゴや写真を追加できます。画像はメールと一緒に送られるので、受信者が読み込む必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 버튼으로 로고나 사진을 추가하세요. 사진은 메일과 함께 보내지므로 받는 사람이 불러올 필요가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een logo of foto toe met de afbeeldingsknop. Afbeeldingen gaan met de mail mee, dus niemand hoeft ze te laden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj logo lub zdjęcie przyciskiem obrazu. Obrazy są wysyłane razem z wiadomością, więc nikt nie musi ich wczytywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um logotipo ou foto com o botão de imagem. As imagens vão junto com o e-mail, então ninguém precisa carregá-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте логотип или фото кнопкой изображения. Изображения отправляются вместе с письмом, так что их не нужно загружать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en logotyp eller ett foto med bildknappen. Bilderna skickas med mejlet, så ingen behöver läsa in dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resim düğmesiyle logo ya da fotoğraf ekle. Resimler e-postayla birlikte gider, kimsenin yüklemesi gerekmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用图片按钮添加徽标或照片。图片随邮件一起发送，收件人无需加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用圖片按鈕加入標誌或照片。圖片會隨郵件一起寄出，收件人無需載入。"
          }
        }
      }
    },
