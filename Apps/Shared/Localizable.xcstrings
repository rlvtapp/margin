        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Margin a leveleidben kapott meghívók megbeszéléseit mutatja. Kapcsolj össze egy postafiókot, hogy a teljes naptárát lásd."
