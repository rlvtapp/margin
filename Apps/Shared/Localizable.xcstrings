    "It uses the tools you allow in Settings → Assistant. Undo puts back what it changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er nutzt die Werkzeuge, die du unter Einstellungen → Assistent erlaubst. „Widerrufen“ macht seine Änderungen rückgängig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa las herramientas que permitas en Ajustes → Asistente. «Deshacer» revierte lo que haya cambiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il utilise les outils que vous autorisez dans Réglages → Assistant. « Annuler » rétablit ce qu’il a modifié."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il utilise les outils que vous autorisez dans Réglages → Assistant. « Annuler » rétablit ce qu’il a modifié."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह वही टूल इस्तेमाल करता है जिनकी आप सेटिंग्ज़ → असिस्टेंट में अनुमति देते हैं। “पूर्ववत करें” इसके बदलाव वापस कर देता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azokat az eszközöket használja, amelyeket a Beállítások → Asszisztens részben engedélyezel. A Visszavonás visszaállítja, amit módosított."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa gli strumenti che consenti in Impostazioni → Assistente. “Annulla” ripristina ciò che ha modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → アシスタントで許可したツールを使います。「取り消す」で変更を元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → 어시스턴트에서 허용한 도구를 사용해요. ‘실행 취소’로 변경한 내용을 되돌릴 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij gebruikt de hulpmiddelen die je toestaat in Instellingen → Assistent. ‘Herstel’ zet terug wat hij heeft gewijzigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele usa as ferramentas que você permitir em Ajustes → Assistente. “Desfazer” reverte o que ele mudou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он использует инструменты, разрешённые в Настройки → Ассистент. «Отменить» возвращает внесённые изменения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会使用你在“设置 → 助手”中允许的工具。“撤销”可还原它所做的更改。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar → Asistan bölümünde izin verdiğiniz araçları kullanır. Geri Al, yaptığı değişiklikleri geri getirir."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它會使用你在「設定」→「助理」中允許的工具。「還原」可復原它所做的更改。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korzysta z narzędzi, na które zezwalasz w Ustawieniach → Asystent. „Cofnij” przywraca wprowadzone zmiany."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den använder verktygen du tillåter i Inställningar → Assistent. Ångra återställer det den ändrade."
