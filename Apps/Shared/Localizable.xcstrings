          "stringUnit" : {
            "state" : "translated",
            "value" : "Их письма сразу идут в Корзину."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其邮件会直接进入废纸篓。"
          }
