    },
    "No workspaces yet. Group your mailboxes, like Work and Personal, to see one group at a time." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun espace de travail pour l’instant. Regroupez vos boîtes aux lettres, par exemple Travail et Personnel, pour voir un groupe à la fois."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen werkruimten. Groepeer je mailboxen, zoals Werk en Privé, om één groep tegelijk te zien."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークスペースはまだありません。「仕事」や「個人」のようにメールボックスをグループにまとめると、1つずつ表示できます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay espacios de trabajo. Agrupa tus buzones, como Trabajo y Personal, para ver un grupo cada vez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Arbeitsbereiche. Gruppiere deine Postfächer, etwa Arbeit und Privat, um jeweils eine Gruppe zu sehen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuno spazio di lavoro. Raggruppa le caselle, come Lavoro e Personale, per vedere un gruppo alla volta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum espaço de trabalho ainda. Agrupe suas caixas de correio, como Trabalho e Pessoal, para ver um grupo por vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рабочих пространств пока нет. Объединяйте ящики в группы, например «Работа» и «Личное», чтобы видеть по одной группе."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincsenek munkaterületek. Csoportosítsd a postafiókjaidat, például Munka és Személyes szerint, hogy egyszerre egy csoportot láss."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 작업 공간이 없습니다. 업무, 개인처럼 메일상자를 그룹으로 묶어 한 번에 한 그룹씩 보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有工作区。将邮箱分组，例如“工作”和“个人”，即可一次查看一个分组。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई वर्कस्पेस नहीं है। एक बार में एक समूह देखने के लिए अपने मेलबॉक्स को समूहों में रखें, जैसे काम और निजी।"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun espace de travail pour l’instant. Regroupez vos boîtes aux lettres, par exemple Travail et Personnel, pour voir un groupe à la fois."
          }
        }
      }
    },
