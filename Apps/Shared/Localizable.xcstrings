            "state" : "translated",
            "value" : "Poczta od tej osoby trafia prosto do kosza."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejl från dem hamnar direkt i papperskorgen."
          }
        }
      }
    },
