    "Their mail goes straight to Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Mails landen direkt im Papierkorb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su correo va directo a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leurs e-mails vont directement à la corbeille."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leurs courriels vont directement à la corbeille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनकी मेल सीधे ट्रैश में जाती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A leveleik egyenesen a Kukába kerülnek."
          }
