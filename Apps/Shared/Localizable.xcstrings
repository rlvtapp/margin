    "Some providers send your address along; the relay keeps only a scrambled form of it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Anbieter schicken deine Adresse mit; das Relay behält davon nur eine unkenntlich gemachte Form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos proveedores envían tu dirección; el relé solo guarda una versión cifrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains fournisseurs joignent votre adresse ; le relais n’en garde qu’une forme brouillée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains fournisseurs joignent votre adresse; le relais n’en garde qu’une forme brouillée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ प्रदाता आपका पता भी भेजते हैं; रिले उसका सिर्फ़ बदला हुआ रूप रखता है।"
