    "Contacts stay on this device and are only used to suggest people while you write." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakte bleiben auf diesem Gerät und dienen nur dazu, beim Schreiben Personen vorzuschlagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los contactos se quedan en este dispositivo y solo sirven para sugerir personas mientras escribes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contacts restent sur cet appareil et servent uniquement à suggérer des personnes pendant que vous écrivez."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contacts restent sur cet appareil et servent uniquement à suggérer des personnes pendant que vous écrivez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संपर्क इसी डिवाइस पर रहते हैं और सिर्फ़ लिखते समय लोगों के सुझाव देने में काम आते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A névjegyek ezen az eszközön maradnak, és csak írás közbeni javaslatokhoz használjuk őket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contatti restano su questo dispositivo e servono solo a suggerire persone mentre scrivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先はこのデバイスに保存され、メール作成時の宛先候補にのみ使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처는 이 기기에만 저장되며 메일을 쓸 때 사람을 추천하는 데만 사용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacten blijven op dit apparaat en worden alleen gebruikt om mensen voor te stellen terwijl je schrijft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os contatos ficam neste dispositivo e só servem para sugerir pessoas enquanto você escreve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контакты хранятся на этом устройстве и нужны только для подсказок, пока вы пишете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "联系人仅保存在此设备上，只用于写邮件时推荐收件人。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişiler bu aygıtta kalır ve yalnızca siz yazarken kişi önermek için kullanılır."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聯絡人只會保留在這部裝置上，僅用於你撰寫郵件時建議收件人。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakty zostają na tym urządzeniu i służą tylko do podpowiadania osób podczas pisania."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakter stannar på den här enheten och används bara för att föreslå personer medan du skriver."
          }
        }
      }
    },
    "Contacts, VIPs and people you've written to, plus sign-in codes. Newsletters and updates stay quiet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakte, VIPs und Leute, denen du geschrieben hast, plus Anmeldecodes. Newsletter und Updates bleiben still."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contactos, VIP y gente a la que escribiste, más códigos de inicio de sesión. Las newsletters y avisos no suenan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacts, VIP et personnes à qui vous avez écrit, plus les codes de connexion. Newsletters et mises à jour restent silencieuses."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
