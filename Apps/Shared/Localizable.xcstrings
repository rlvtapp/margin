    "In %@. Margin hasn't seen enough of your %@ yet, so only your general style is used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %1$@. Margin hat noch nicht genug von deinem %2$@ gesehen, daher wird nur dein allgemeiner Stil genutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %1$@. Margin aún no ha visto suficiente de tu %2$@, así que solo usa tu estilo general."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %1$@. Margin n’a pas encore vu assez de votre %2$@, seul votre style général est utilisé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %1$@. Margin n’a pas encore vu assez de votre %2$@, seul votre style général est utilisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ में। Margin ने अभी आपकी %2$@ ज़्यादा नहीं देखी, इसलिए सिर्फ़ आपकी सामान्य शैली इस्तेमाल हुई।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nyelven. A Margin még nem látott elég %2$@ szöveget tőled, ezért csak az általános stílusodat használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %1$@. Margin non ha ancora visto abbastanza del tuo %2$@, quindi usa solo il tuo stile generale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@で。Margin はまだあなたの%2$@を十分に見ていないため、全体的なスタイルのみを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@로. Margin이 아직 당신의 %2$@를 충분히 보지 못해 일반적인 스타일만 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In het %1$@. Margin heeft nog niet genoeg van je %2$@ gezien, dus alleen je algemene stijl wordt gebruikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em %1$@. O Margin ainda não viu o suficiente do seu %2$@, então usa só o seu estilo geral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На языке «%1$@». Margin пока видел мало ваших писем на языке «%2$@», поэтому использует только общий стиль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用%1$@。Margin 还没看到足够多你的%2$@写作，因此只使用你的总体风格。"
          }
        }
      }
    },
