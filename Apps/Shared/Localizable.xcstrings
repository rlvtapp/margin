    "It never sees your mail, who sent it or your passwords." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sieht nie deine Mail, wer sie geschickt hat, oder deine Passwörter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca ve tu correo, quién lo envió ni tus contraseñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne voit jamais vos e-mails, leurs expéditeurs ni vos mots de passe."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne voit jamais vos courriels, leurs expéditeurs ni vos mots de passe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कभी आपकी मेल, भेजने वाले या आपके पासवर्ड नहीं देखता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soha nem látja a leveleidet, a feladót vagy a jelszavaidat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non vede mai la tua posta, chi l’ha inviata o le tue password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールの中身、差出人、パスワードは一切見えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일 내용, 보낸 사람, 비밀번호는 절대 보지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij ziet nooit je mail, wie hem stuurde of je wachtwoorden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele nunca vê seus e-mails, quem os enviou nem suas senhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он никогда не видит ваши письма, их отправителей и пароли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它永远看不到你的邮件内容、发件人或密码。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postanızı, kimin gönderdiğini veya parolalarınızı asla görmez."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它絕不會看到你的郵件、寄件人或密碼。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy nie widzi Twojej poczty, jej nadawców ani Twoich haseł."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser aldrig din e-post, vem som skickade den eller dina lösenord."
          }
        }
      }
    },
    "It only learns that something new arrived." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es erfährt nur, dass etwas Neues da ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo sabe que ha llegado algo nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sait seulement qu’il y a du nouveau."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sait seulement qu’il y a du nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे सिर्फ़ इतना पता चलता है कि कुछ नया आया है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak annyit tud, hogy valami új érkezett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa solo che è arrivato qualcosa di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
