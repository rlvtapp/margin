    "Nothing is sent or saved. The reply uses the assistant you chose, in the email's language." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wird gesendet oder gespeichert. Die Antwort nutzt den gewählten Assistenten, in der Sprache der E-Mail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envía ni guarda nada. La respuesta usa el asistente que elegiste, en el idioma del correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est envoyé ni enregistré. La réponse utilise l’assistant choisi, dans la langue de l’e-mail."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est envoyé ni enregistré. La réponse utilise l’assistant choisi, dans la langue du courriel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ भी भेजा या सहेजा नहीं जाता। जवाब आपके चुने असिस्टेंट से, ईमेल की भाषा में लिखा जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semmit nem küldünk el és nem mentünk. A válasz a választott asszisztenssel, az e-mail nyelvén készül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non viene inviato né salvato nulla. La risposta usa l’assistente scelto, nella lingua dell’email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信も保存もされません。返信は選んだアシスタントが、メールの言語で書きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 보내거나 저장하지 않습니다. 답장은 선택한 어시스턴트가 이메일의 언어로 씁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
