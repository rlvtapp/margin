    "%@ can't take actions, so %@ took over." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kann keine Aktionen ausführen, deshalb hat %2$@ übernommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no puede realizar acciones, así que %2$@ se encargó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne peut pas effectuer d’actions, donc %2$@ a pris le relais."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne peut pas effectuer d’actions, donc %2$@ a pris le relais."
