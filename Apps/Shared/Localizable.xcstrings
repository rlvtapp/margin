    "Three quick answers under mail from people. Tap one to write it out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei schnelle Antworten unter E-Mails von Personen. Tippe auf eine, um sie auszuformulieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres respuestas rápidas bajo el correo de personas. Toca una para escribirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois réponses rapides sous les e-mails de personnes. Touchez-en une pour la rédiger."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois réponses rapides sous les courriels de personnes. Touchez-en une pour la rédiger."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोगों के मेल के नीचे तीन त्वरित जवाब। पूरा लिखने के लिए किसी एक पर टैप करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Három gyors válasz az emberektől érkezett levelek alatt. Koppints az egyikre, és kidolgozza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre risposte rapide sotto la posta di persone. Tocca una per scriverla per esteso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人からのメールの下に短い返信を3つ表示します。タップすると返信文を作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사람들이 보낸 메일 아래에 빠른 답변 세 가지가 나와요. 탭하면 전체 문장으로 작성돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drie snelle antwoorden onder mail van mensen. Tik erop om het uit te schrijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três respostas rápidas abaixo dos e-mails de pessoas. Toque em uma para escrevê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три быстрых ответа под письмами от людей. Нажмите на один, чтобы составить письмо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在来自个人的邮件下方显示三个快速回答。点按其中一个即可写出完整回复。"
          }
        },
        "tr" : {
          "stringUnit" : {
