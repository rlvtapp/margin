    "Tracker blocking removes the hidden pictures that report when you open mail, and takes the tracking out of links." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le blocage des traqueurs supprime les images cachées qui signalent quand vous ouvrez un e-mail, et retire le suivi des liens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trackers blokkeren verwijdert de verborgen afbeeldingen die melden wanneer je mail opent, en haalt de tracking uit links."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラッカーをブロックすると、メールを開いたことを知らせる隠し画像が削除され、リンクから追跡が取り除かれます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloqueo de rastreadores elimina las imágenes ocultas que avisan cuando abres un correo y quita el rastreo de los enlaces."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tracker-Blockierung entfernt versteckte Bilder, die melden, wann du eine E-Mail öffnest, und entfernt das Tracking aus Links."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco dei tracker rimuove le immagini nascoste che segnalano quando apri un’email e toglie il tracciamento dai link."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bloqueio de rastreadores remove as imagens ocultas que avisam quando você abre um e-mail e tira o rastreamento dos links."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокировка трекеров удаляет скрытые изображения, которые сообщают об открытии письма, и убирает отслеживание из ссылок."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A követők letiltása eltávolítja a rejtett képeket, amelyek jelzik, ha megnyitsz egy levelet, és kiveszi a követést a linkekből."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추적기 차단은 메일을 열었는지 알리는 숨겨진 이미지를 제거하고 링크에서 추적을 없앱니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阻止跟踪器会移除在你打开邮件时发出通知的隐藏图片，并去除链接中的跟踪。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रैकर ब्लॉक करने से वे छिपी तस्वीरें हट जाती हैं जो मेल खोलने पर सूचना भेजती हैं, और लिंक से ट्रैकिंग निकल जाती है।"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le blocage des traqueurs supprime les images cachées qui signalent quand vous ouvrez un courriel, et retire le suivi des liens."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzleyici engelleme, postayı açtığınızda bunu bildiren gizli resimleri kaldırır ve bağlantılardaki izlemeyi çıkarır."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阻擋追蹤器會移除那些在你打開郵件時回報的隱藏圖片，並移除連結中的追蹤資訊。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokowanie modułów śledzących usuwa ukryte obrazki, które informują o otwarciu wiadomości, i usuwa śledzenie z linków."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spårningsblockering tar bort de dolda bilderna som rapporterar när du öppnar e-post, och tar bort spårningen från länkar."
          }
        }
      }
    },
