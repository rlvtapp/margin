    "Replies to a muted conversation are archived and marked read. Mute one from its … menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten in stummen Konversationen werden archiviert und als gelesen markiert. Stummschalten im …-Menü."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas a una conversación silenciada se archivan y se marcan como leídas. Silencia una desde su menú …."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses à une conversation en sourdine sont archivées et marquées comme lues. Mettez-en une en sourdine depuis son menu …."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses à une conversation en sourdine sont archivées et marquées comme lues. Mettez-en une en sourdine depuis son menu …."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "म्यूट बातचीत के जवाब आर्काइव होकर पढ़े हुए चिह्नित होते हैं। … मेन्यू से म्यूट करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A némított beszélgetésekre érkező válaszok archiválva és olvasottként jelölve lesznek. Némítás a … menüből."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte a una conversazione silenziata vengono archiviate e segnate come lette. Silenziane una dal menu …."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミュートした会話への返信はアーカイブされ、既読になります。…メニューからミュートできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음소거한 대화의 답장은 보관되고 읽음 처리됩니다. … 메뉴에서 음소거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwoorden in een gedempt gesprek worden gearchiveerd en als gelezen gemarkeerd. Demp er een via het …-menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respostas a uma conversa silenciada são arquivadas e marcadas como lidas. Silencie pelo menu …."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответы в беседах без звука архивируются и отмечаются прочитанными. Отключить звук можно в меню …."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静音对话的回复会被归档并标为已读。可在对话的 … 菜单中静音。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessize alınmış bir yazışmaya gelen yanıtlar arşivlenir ve okundu olarak işaretlenir. Bir yazışmayı … menüsünden sessize alın."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已靜音對話的回覆會被封存並標示為已讀。可從對話的「⋯」選單將其設為靜音。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedzi w wyciszonej rozmowie są archiwizowane i oznaczane jako przeczytane. Rozmowę wyciszysz w jej menu …."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar i en tystad konversation arkiveras och markeras som lästa. Tysta en konversation via dess meny …."
          }
        }
      }
    },
