    "Offline. Showing saved mail; it keeps trying." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline. Gespeicherte Mails werden gezeigt; es wird weiter versucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
