    "Margin shows meetings from invitations in your mail. Connect a mailbox to see its whole calendar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin zeigt Termine aus Einladungen in deinen E-Mails. Verbinde ein Postfach, um seinen ganzen Kalender zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
