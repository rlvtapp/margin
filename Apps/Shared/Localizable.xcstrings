    "In %@. Margin hasn't seen enough of your %@ yet, so only your general style is used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %1$@. Margin hat noch nicht genug von deinem %2$@ gesehen, daher wird nur dein allgemeiner Stil genutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %1$@. Margin aún no ha visto suficiente de tu %2$@, así que solo usa tu estilo general."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %1$@. Margin n’a pas encore vu assez de votre %2$@, seul votre style général est utilisé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %1$@. Margin n’a pas encore vu assez de votre %2$@, seul votre style général est utilisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ में। Margin ने अभी आपकी %2$@ ज़्यादा नहीं देखी, इसलिए सिर्फ़ आपकी सामान्य शैली इस्तेमाल हुई।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nyelven. A Margin még nem látott elég %2$@ szöveget tőled, ezért csak az általános stílusodat használja."
          }
        },
        "it" : {
          "stringUnit" : {
