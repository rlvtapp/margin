        }
      }
    },
    "Each list is told you're leaving, and their issues are cleared from your inbox." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Liste erfährt, dass du dich abmeldest, und ihre Ausgaben werden aus deinem Posteingang entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se avisa a cada lista de que te das de baja y se quitan sus ediciones de tu bandeja de entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque liste est informée de votre départ, et ses envois sont retirés de votre boîte de réception."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque liste est informée de votre départ, et ses envois sont retirés de votre boîte de réception."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर सूची को बता दिया जाता है कि आप छोड़ रहे हैं, और उनके अंक आपके इनबॉक्स से हटा दिए जाते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden listát értesítünk a leiratkozásodról, és a kiadásaik eltűnnek a beérkezett levelek közül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni lista viene avvisata che ti stai disiscrivendo e le sue edizioni vengono tolte dalla posta in arrivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各リストに配信停止を伝え、受信ボックスにある分も片付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 목록에 수신 거부가 전달되고, 해당 메일이 받은 편지함에서 지워져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke lijst krijgt door dat je je afmeldt, en de nummers verdwijnen uit Inkomend."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada lista é avisada de que você está saindo e as edições delas são removidas da sua caixa de entrada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая рассылка узнает, что вы отписались, а её выпуски будут убраны из входящих."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统会通知每个列表你已退订，并将它们的邮件从收件箱中清除。"
          }
        }
      }
    },
    "Each mailbox can have its own setting: Mailboxes → Edit…. Workspaces you're not in stay quiet." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque boîte aux lettres peut avoir son propre réglage : Boîtes aux lettres → Modifier…. Les espaces de travail où vous n’êtes pas restent silencieux."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke mailbox kan een eigen instelling hebben: Mailboxen → Wijzig…. Werkruimten waarin je niet zit, blijven stil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールボックスごとに設定できます：メールボックス → 編集…。今いないワークスペースは通知しません。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada buzón puede tener su propio ajuste: Buzones → Editar…. Los espacios de trabajo en los que no estás no hacen ruido."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Postfach kann eine eigene Einstellung haben: Postfächer → Bearbeiten …. Arbeitsbereiche, in denen du gerade nicht bist, bleiben still."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni casella può avere la sua impostazione: Caselle → Modifica…. Gli spazi di lavoro in cui non sei restano silenziosi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada caixa de correio pode ter seu próprio ajuste: Caixas de Correio → Editar…. Espaços de trabalho em que você não está ficam em silêncio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого ящика может быть своя настройка: Ящики → Изменить…. Рабочие пространства, в которых вы не находитесь, не беспокоят."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden postafióknak lehet saját beállítása: Postafiókok → Szerkesztés…. Azok a munkaterületek, amelyekben épp nem vagy, csendben maradnak."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일상자마다 따로 설정할 수 있습니다: 메일상자 → 편집…. 현재 있지 않은 작업 공간은 조용히 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个邮箱都可以单独设置：邮箱 → 编辑…。你不在的工作区会保持安静。"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर मेलबॉक्स की अपनी सेटिंग हो सकती है: मेलबॉक्स → संपादित करें…। जिन वर्कस्पेस में आप नहीं हैं, वे शांत रहते हैं।"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque boîte aux lettres peut avoir son propre réglage : Boîtes aux lettres → Modifier…. Les espaces de travail où vous n’êtes pas restent silencieux."
          }
        }
      }
    },
