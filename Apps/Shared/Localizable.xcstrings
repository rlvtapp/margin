    "Its own come first. Those from %@ are in the signature menu while writing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die eigenen gehen vor. Die aus %@ stehen beim Schreiben im Signaturmenü."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las propias van primero. Las de %@ están en el menú de firma al escribir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les siennes passent d'abord. Celles de %@ sont dans le menu des signatures pendant la rédaction."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les siennes passent d'abord. Celles de %@ sont dans le menu des signatures pendant la rédaction."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके अपने हस्ताक्षर पहले आते हैं। %@ वाले लिखते समय हस्ताक्षर मेनू में होते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sajátjai az elsők. A(z) %@ aláírásai írás közben az aláírás menüben vannak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sue vengono prima. Quelle di %@ sono nel menu delle firme mentre scrivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自の署名が優先されます。%@の署名は作成中の署名メニューにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자체 서명이 우선입니다. %@의 서명은 작성 중 서명 메뉴에 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eigen gaan voor. Die van %@ staan tijdens het schrijven in het handtekeningmenu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw własne. Te z: %@ są w menu podpisu podczas pisania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As próprias vêm primeiro. As de %@ ficam no menu de assinatura ao escrever."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала свои. Подписи из «%@» есть в меню подписи при написании."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess egna kommer först. De från %@ finns i signaturmenyn när du skriver."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce kendi imzaları gelir. %@ imzaları yazarken imza menüsündedir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先使用自己的签名。“%@”的签名在写邮件时的签名菜单中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先使用自己的簽名。「%@」的簽名在撰寫時的簽名選單中。"
          }
        }
      }
    },
    "Its own sound, so a meeting doesn't sound like an email." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein eigener Ton, damit ein Termin nicht wie eine E-Mail klingt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sonido propio, para que una reunión no suene como un correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un son à part, pour qu’une réunion ne sonne pas comme un courriel."
          }
        },
