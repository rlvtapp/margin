          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Margin mostra reuniões dos convites nos seus e-mails. Conecte uma caixa para ver todo o calendário dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin показывает встречи из приглашений в почте. Подключите ящик, чтобы видеть весь его календарь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin visar möten från inbjudningar i din e-post. Anslut en brevlåda för att se hela dess kalender."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin, e-postalarındaki davetlerden toplantıları gösterir. Tüm takvimini görmek için bir posta kutusu bağla."
