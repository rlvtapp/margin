    "Microsoft asked Margin to wait a few minutes before signing in again. It will try again by itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft hat Margin gebeten, vor der nächsten Anmeldung ein paar Minuten zu warten. Margin versucht es von selbst erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft ha pedido a Margin que espere unos minutos antes de volver a iniciar sesión. Lo intentará de nuevo por sí solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft a demandé à Margin d’attendre quelques minutes avant de se reconnecter. Margin réessaiera tout seul."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft a demandé à Margin d’attendre quelques minutes avant de se reconnecter. Margin réessaiera tout seul."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft ने Margin से दोबारा साइन इन करने से पहले कुछ मिनट रुकने को कहा है। Margin अपने आप फिर कोशिश करेगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Microsoft arra kérte a Margint, hogy várjon néhány percet az újabb bejelentkezés előtt. Magától újrapróbálja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft ha chiesto a Margin di attendere qualche minuto prima di accedere di nuovo. Riproverà da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoftから、再度サインインする前に数分待つよう求められました。Marginが自動的に再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft에서 다시 로그인하기 전에 몇 분 기다려 달라고 요청했습니다. Margin이 자동으로 다시 시도합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft vroeg Margin een paar minuten te wachten voordat het opnieuw inlogt. Margin probeert het vanzelf opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Microsoft pediu ao Margin que espere alguns minutos antes de entrar novamente. Ele tentará de novo sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft попросил Margin подождать несколько минут перед повторным входом. Margin попробует снова сам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft 要求 Margin 等几分钟后再重新登录。Margin 会自动重试。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft, Margin’den yeniden oturum açmadan önce birkaç dakika beklemesini istedi. Margin kendiliğinden yeniden deneyecek."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft 要求 Margin 等幾分鐘後再重新登入。Margin 會自動重試。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft poprosił Margin o odczekanie kilku minut przed ponownym zalogowaniem. Margin spróbuje ponownie samodzielnie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft bad Margin att vänta några minuter innan det loggar in igen. Margin försöker igen av sig självt."
          }
        }
      }
    },
