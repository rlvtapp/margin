    "Label, archive, move, snooze, trash, folders, templates, newsletters and the outbox. Apps can undo their own last change." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Labeln, archivieren, verschieben, zurückstellen, löschen, Ordner, Vorlagen, Newsletter und der Postausgang. Apps können ihre eigene letzte Änderung rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetar, archivar, mover, posponer, eliminar, carpetas, plantillas, newsletters y la bandeja de salida. Las apps pueden deshacer su último cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiqueter, archiver, déplacer, mettre en attente, mettre à la corbeille, dossiers, modèles, infolettres et envois programmés. Les apps peuvent annuler leur dernière modification."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étiqueter, archiver, déplacer, mettre en attente, mettre à la corbeille, dossiers, modèles, infolettres et envois programmés. Les apps peuvent annuler leur dernière modification."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेबल, आर्काइव, मूव, स्नूज़, ट्रैश, फ़ोल्डर, टेम्पलेट, न्यूज़लेटर और आउटबॉक्स। ऐप अपना आखिरी बदलाव पूर्ववत कर सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Címkézés, archiválás, áthelyezés, halasztás, törlés, mappák, sablonok, hírlevelek és a Kimenő. Az alkalmazások visszavonhatják a saját utolsó módosításukat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etichettare, archiviare, spostare, posticipare, eliminare, cartelle, modelli, newsletter e la posta in uscita. Le app possono annullare la propria ultima modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラベル、アーカイブ、移動、スヌーズ、ゴミ箱、フォルダ、テンプレート、ニュースレター、送信予定。アプリは自分の直前の変更を取り消せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이블, 보관, 이동, 다시 알림, 휴지통, 폴더, 템플릿, 뉴스레터, 보낼 편지함. 앱은 자신의 마지막 변경을 되돌릴 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Labelen, archiveren, verplaatsen, snoozen, prullenmand, mappen, sjablonen, nieuwsbrieven en ingeplande mail. Apps kunnen hun eigen laatste wijziging ongedaan maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiquetar, arquivar, mover, adiar, apagar, pastas, modelos, newsletters e a caixa de saída. Os apps podem desfazer a própria última alteração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ярлыки, архивация, перемещение, откладывание, удаление, папки, шаблоны, рассылки и исходящие. Приложения могут отменить своё последнее изменение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签、归档、移动、稍后提醒、废纸篓、文件夹、模板、新闻邮件和发件箱。App 可以撤销自己的上一次更改。"
          }
        }
      }
    },
