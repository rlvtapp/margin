    },
    "Margin only interrupts you for what matters." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin stört dich nur, wenn es wichtig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Margin solo te interrumpe por lo importante."
          }
