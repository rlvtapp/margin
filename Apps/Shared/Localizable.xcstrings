    "%@ gets its mail through iCloud. Sign in with the Apple Account's @icloud.com address; mail still goes out from %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ erhält seine E-Mails über iCloud. Melde dich mit der @icloud.com-Adresse des Apple Accounts an; gesendet wird weiterhin von %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ recibe su correo a través de iCloud. Inicia sesión con la dirección @icloud.com de la cuenta de Apple; el correo se sigue enviando desde %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ reçoit ses e-mails via iCloud. Connectez-vous avec l’adresse @icloud.com du compte Apple ; les e-mails partent toujours de %2$@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ reçoit ses courriels via iCloud. Connectez-vous avec l’adresse @icloud.com du compte Apple ; les courriels partent toujours de %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ का मेल iCloud से आता है। Apple खाते के @icloud.com पते से साइन इन करें; मेल फिर भी %2$@ से जाएगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %1$@ az iCloudon keresztül kapja a leveleit. Jelentkezz be az Apple-fiók @icloud.com-os címével; a levelek továbbra is innen mennek: %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ riceve la posta tramite iCloud. Accedi con l’indirizzo @icloud.com dell’account Apple; la posta parte comunque da %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ のメールは iCloud 経由で届きます。Apple アカウントの @icloud.com アドレスでサインインしてください。送信元は引き続き %2$@ です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) iCloud를 통해 메일을 받습니다. Apple 계정의 @icloud.com 주소로 로그인하세요. 메일은 계속 %2$@에서 보내집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ krijgt zijn mail via iCloud. Log in met het @icloud.com-adres van het Apple-account; mail gaat nog steeds uit vanaf %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ odbiera pocztę przez iCloud. Zaloguj się adresem @icloud.com konta Apple; poczta nadal wychodzi z %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ recebe e-mails pelo iCloud. Entre com o endereço @icloud.com da Conta Apple; os e-mails continuam saindo de %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ получает почту через iCloud. Войдите с адресом @icloud.com аккаунта Apple; письма по-прежнему уходят с %2$@."
