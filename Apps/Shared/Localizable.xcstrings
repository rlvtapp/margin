    "Yahoo needs an app password from your account security settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yahoo braucht ein App-Passwort aus den Sicherheitseinstellungen deines Kontos."
