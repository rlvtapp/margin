          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可以回答问题，但无法执行操作。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ soruları yanıtlayabilir ancak işlem yapamaz."
