# Cache rules for the static site (Cloudflare reads this file from the built output).
# Built files have a hash in their names, so they can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pictures and icons keep their names when they change, so they're kept for a day.
/images/*
  Cache-Control: public, max-age=86400

/icon*
  Cache-Control: public, max-age=86400

/favicon*
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400
